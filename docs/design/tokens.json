{
  "$comment": [
    "SINGLE SOURCE OF TRUTH for every design value in this project.",
    "Per ADR-0008, both platform artefacts are GENERATED from this file:",
    "  web/app/globals.css  (@theme block, consumed by Tailwind v4)",
    "  android/.../Tokens.kt (Compose theme values)",
    "Never edit a generated file by hand. Edit this, then run:",
    "  node tools/generate-tokens.mjs",
    "Contrast ratios in docs/design/colour.md are measured against these",
    "exact values. Changing a colour means recomputing them - the",
    "generator verifies this and will refuse to emit a failing palette."
  ],
  "meta": {
    "version": "1.0.0",
    "source": "docs/design/tokens.json",
    "androidPackage": "com.snjewellery.admin.ui.theme",
    "$androidPackageComment": "Provisional - confirm in M6.1. No domain is registered yet, so this is a sensible default rather than a derived reverse-domain name.",
    "documentation": {
      "colour": "docs/design/colour.md",
      "typography": "docs/design/typography.md",
      "layout": "docs/design/layout.md"
    }
  },

  "colour": {
    "light": {
      "surface": "#FFFFFF",
      "surface-raised": "#FAF9F7",
      "surface-sunken": "#F5F3F0",
      "text-primary": "#1C1917",
      "text-secondary": "#57534E",
      "text-muted": "#6B645F",
      "border": "#E7E5E4",
      "border-strong": "#D6D3D1",
      "border-interactive": "#96908B",
      "accent": "#C9A227",
      "accent-text": "#856404",
      "on-accent": "#1C1917",
      "focus": "#1C1917",
      "success": "#15803D",
      "danger": "#B91C1C"
    },
    "dark": {
      "surface": "#0F0F0F",
      "surface-raised": "#1A1917",
      "surface-sunken": "#080808",
      "text-primary": "#FAF9F7",
      "text-secondary": "#A8A29E",
      "text-muted": "#8A8580",
      "border": "#292524",
      "border-strong": "#3F3B39",
      "border-interactive": "#6B6560",
      "accent": "#D4AF37",
      "accent-text": "#E0BC4A",
      "on-accent": "#0F0F0F",
      "focus": "#FAF9F7",
      "success": "#4ADE80",
      "danger": "#F87171"
    }
  },

  "contrastRules": {
    "$comment": [
      "Machine-checkable assertions from docs/design/colour.md.",
      "The generator fails if any of these regress, so a token change",
      "cannot silently break accessibility.",
      "'accent' is deliberately absent from the light-mode non-text checks:",
      "at 2.42:1 on white it is decorative-only by design (colour.md #1)."
    ],
    "bodyTextMin": 4.5,
    "nonTextMin": 3.0,
    "bodyTextPairs": [
      ["text-primary", "surface"],
      ["text-primary", "surface-raised"],
      ["text-primary", "surface-sunken"],
      ["text-secondary", "surface"],
      ["text-secondary", "surface-raised"],
      ["text-secondary", "surface-sunken"],
      ["text-muted", "surface"],
      ["text-muted", "surface-raised"],
      ["text-muted", "surface-sunken"],
      ["accent-text", "surface"],
      ["accent-text", "surface-raised"],
      ["accent-text", "surface-sunken"],
      ["success", "surface"],
      ["danger", "surface"],
      ["on-accent", "accent"]
    ],
    "nonTextPairs": [["border-interactive", "surface"]]
  },

  "font": {
    "family": {
      "display": "Cormorant Garamond",
      "body": "Inter",
      "$comment": "loadedVar names are the CSS variables next/font emits (see web/lib/fonts.ts). The generated stack references those so the self-hosted, subset files are used rather than a system lookup by family name.",
      "displayLoadedVar": "--font-display-loaded",
      "bodyLoadedVar": "--font-body-loaded",
      "displayFallback": "ui-serif, Georgia, serif",
      "bodyFallback": "ui-sans-serif, system-ui, sans-serif"
    },
    "displayMinPx": 28,
    "$comment": "displayMinPx is a hard rule, not a suggestion - see typography.md #1",
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    },
    "scale": {
      "display-xl": { "min": "2.25rem", "max": "3.5rem", "fluid": "5vw", "lineHeight": 1.1, "weight": 500, "tracking": "-0.02em", "family": "display" },
      "display-l": { "min": "1.875rem", "max": "2.75rem", "fluid": "4vw", "lineHeight": 1.15, "weight": 500, "tracking": "-0.015em", "family": "display" },
      "heading-l": { "size": "1.75rem", "lineHeight": 1.25, "weight": 500, "tracking": "-0.01em", "family": "display" },
      "heading-m": { "size": "1.375rem", "lineHeight": 1.35, "weight": 600, "tracking": "-0.01em", "family": "body" },
      "heading-s": { "size": "1.125rem", "lineHeight": 1.4, "weight": 600, "tracking": "0", "family": "body" },
      "body-l": { "size": "1.125rem", "lineHeight": 1.6, "weight": 400, "tracking": "0", "family": "body" },
      "body-m": { "size": "1rem", "lineHeight": 1.6, "weight": 400, "tracking": "0", "family": "body" },
      "body-s": { "size": "0.875rem", "lineHeight": 1.5, "weight": 400, "tracking": "0", "family": "body" },
      "caption": { "size": "0.8125rem", "lineHeight": 1.45, "weight": 400, "tracking": "0", "family": "body" },
      "label": { "size": "0.75rem", "lineHeight": 1.3, "weight": 600, "tracking": "0.06em", "family": "body", "transform": "uppercase" },
      "spec": { "size": "1rem", "lineHeight": 1.5, "weight": 500, "tracking": "0", "family": "body", "numeric": "tabular-nums" }
    }
  },

  "space": {
    "0": "0",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2rem",
    "10": "2.5rem",
    "12": "3rem",
    "16": "4rem",
    "20": "5rem",
    "24": "6rem",
    "32": "8rem"
  },

  "radius": {
    "none": "0",
    "sm": "0.125rem",
    "md": "0.25rem",
    "lg": "0.5rem",
    "full": "9999px"
  },

  "elevation": {
    "0": "none",
    "1": "0 1px 2px rgb(0 0 0 / 0.04)",
    "2": "0 2px 8px rgb(0 0 0 / 0.06)",
    "3": "0 8px 24px rgb(0 0 0 / 0.10)"
  },

  "motion": {
    "$comment": "See docs/design/motion.md. Durations are deliberately short: motion supports the photography, it never performs.",
    "duration": {
      "instant": "0ms",
      "fast": "120ms",
      "base": "200ms",
      "slow": "320ms",
      "deliberate": "480ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "decelerate": "cubic-bezier(0, 0, 0, 1)",
      "accelerate": "cubic-bezier(0.3, 0, 1, 1)"
    }
  },

  "aspect": {
    "$comment": "Fixed product image ratios so layout shift is structurally impossible - see responsive.md.",
    "product": "1 / 1",
    "product-portrait": "4 / 5",
    "hero": "16 / 9",
    "hero-mobile": "4 / 5"
  },

  "breakpoint": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "2xl": "1536px"
  },

  "container": {
    "prose": "42.5rem",
    "content": "80rem",
    "wide": "96rem"
  },

  "touchTarget": {
    "web": "44px",
    "android": "48dp"
  }
}
