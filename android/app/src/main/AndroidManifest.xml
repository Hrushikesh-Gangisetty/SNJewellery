<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Read, never required. The app is usable enough to say "you are
      offline" without it, and M8's offline drafts are the real answer to
      a lost connection.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      M7.3. The only runtime permission this app asks for, as
      docs/architecture/android-build.md §2 predicted: choosing existing
      photographs needs none at all, because the Photo Picker is
      permission-free on every supported version.

      Worth being plain about: declaring it is what makes it required.
      ACTION_IMAGE_CAPTURE asks nothing of an app that does not declare
      CAMERA — the camera app holds the permission, not us — but an app
      that DOES declare it must also hold it, or the system refuses the
      launch. So this line creates the one permission dialog the owner
      ever sees, and deleting it plus the request flow in ProductImages.kt
      would remove it.

      It stays because M7.3 asks for a permission path and because
      docs/architecture/android-build.md §2 committed to exactly this one.
      Revisit if the dialog turns out to be friction that buys nothing.
    -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      required="false" so a phone with no camera still installs. The app
      is usable without one — the gallery path in M7.4 needs no camera at
      all — and the capture button reports the absence rather than
      disappearing.
    -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <application
        android:name=".SnJewelleryApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.SnJewelleryAdmin">

        <!--
          allowBackup is false deliberately: this app holds an
          authenticated admin session (M6.8). Letting it into cloud
          backup would put a session token somewhere outside the
          device's protected storage. See CLAUDE.md §9.

          dataExtractionRules is the Android 12+ form of the same rule;
          allowBackup still covers everything below it.
        -->

        <!-- No android:label here: it would repeat the application's. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SnJewelleryAdmin"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          M7.3. A camera app cannot write into this app's private storage,
          and it must not be handed a `file://` URI — that has thrown
          FileUriExposedException since Android 7. FileProvider gives it a
          `content://` URI scoped to one file, granted for one launch.

          The authority carries ${applicationId}, so the debug build's
          `.debug` suffix gives it a different one. Two providers claiming
          the same authority is an install failure, and the debug and
          release builds are meant to sit on the same phone.

          exported="false" with grantUriPermissions="true": nothing may
          query this provider, and the temporary grant that rides on the
          capture intent is the only access anything gets.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.staged"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
