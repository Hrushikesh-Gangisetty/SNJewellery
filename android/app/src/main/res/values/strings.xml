    <string name="categories_hidden_effect">Removed from the website, along with every piece filed under it. Kept here, and you can put it back.</string>

    <!-- The order on screen has just been re-read, so this says why it
         moved back rather than only that something failed. -->
    <string name="categories_reorder_failed_title">The order was not saved</string>
    <string name="categories_reorder_offline">No connection, so the new order could not be saved. The list has been put back to what the catalogue has.</string>
    <string name="categories_reorder_error">The new order could not be saved (%1$s). The list has been put back to what the catalogue has.</string>
    <string name="categories_reorder_missing">One of those categories is no longer there — it looks like it was deleted somewhere else. The list has been refreshed.</string>
    <string name="categories_notice_dismiss">OK</string>

    <string name="categories_error_name_blank">Give the category a name.</string>
    <!-- The database allows it — only the slug is unique — but two
         categories with one name are indistinguishable in the Add Product
         picker and on the website. -->
    <string name="categories_error_name_taken">You already have a category with this name.</string>
    <string name="categories_error_name_exhausted">There are already too many categories with names like this one. Please choose a slightly different name.</string>
    <!-- ── Deletion with pieces in it (M8.8) ─────────────────────────
      Blocked, not reassigned — ADR-0011. Not a fault, and retrying will
      never work: the pieces have to be refiled first, so the message
      says how many there are and offers the way to them.

      Archived pieces are counted. They hold the foreign key exactly as a
      live piece does, and excluding them would produce the one genuinely
      confusing sentence available here: "0 pieces are filed under this
      category, so it cannot be deleted."
    -->
    <plurals name="categories_error_in_use_count">
        <item quantity="one">One piece is filed under this category, so it cannot be deleted. Move it to another category first.</item>
        <item quantity="other">%1$d pieces are filed under this category, so it cannot be deleted. Move them to another category first.</item>
    </plurals>
    <!-- When the count itself could not be read. The refusal is still
         correct; it just cannot say how many. -->
    <string name="categories_error_in_use">There are pieces filed under this category, so it cannot be deleted. Move them to another category first.</string>
    <string name="categories_show_pieces">Show these pieces</string>
    <string name="categories_error_offline">No connection, so nothing was changed. Check your signal and try again.</string>
    <string name="categories_error_server">That could not be saved (%1$s). Please try again.</string>

    <!-- Deleted from another device. Nothing here can be saved to a row
         that is gone, so a refresh is what resolves it, not a retry. -->
    <string name="categories_missing">This category is no longer there — it looks like it was deleted somewhere else.</string>
    <string name="categories_missing_refresh">Refresh the list</string>

    <string name="dashboard_view_catalogue">View catalogue</string>
    <!-- Beside View catalogue, and shown whether or not there are pieces:
         setting the categories up is what an owner does BEFORE the first
         upload, which is exactly when the catalogue is empty. -->
    <string name="dashboard_categories">Categories</string>
    <!-- M6.11 left the dashboard's empty state without a next step because
         the one it wanted had nowhere to go. M7 built the destination. -->
    <string name="dashboard_add_first_product">Add your first product</string>
</resources>
