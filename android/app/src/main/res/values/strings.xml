<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The launcher label. Short deliberately: Android truncates a long
      label under the icon, and "SN Jewellery & Silver Palace" would be
      unreadable there. brand.md §1 allows the short form where space
      genuinely constrains it, which is the same reason the website's
      mobile header uses site.shortName.
    -->
    <string name="app_name">SN Admin</string>

    <!-- Shown after signing in, until the dashboard replaces it in M6.11.
         Says plainly that the app is unfinished rather than presenting a
         convincing empty screen. Reworded once sign-in existed: the
         previous copy promised sign-in "in the next build", which stopped
         being true the moment M6.7 shipped. -->
    <string name="shell_subtitle">You are signed in. The dashboard is not built yet.</string>

    <!-- Whether this build was given backend credentials. An admin
         handed a build without them would otherwise meet a network
         error at the first sign-in and go looking for a signal problem
         that does not exist. Goes with the shell screen in M6.7. -->
    <string name="shell_backend_ready">Backend configured</string>
    <string name="shell_backend_missing">Not configured — missing %1$s in local.properties</string>

    <!-- ── Login (M6.7) ──────────────────────────────────────────── -->
    <string name="login_subtitle">Sign in to manage the catalogue.</string>
    <string name="login_email_label">Email</string>
    <string name="login_password_label">Password</string>
    <string name="login_password_show">Show</string>
    <string name="login_password_hide">Hide</string>
    <string name="login_submit">Sign in</string>

    <string name="login_email_required">Enter your email address.</string>
    <string name="login_email_malformed">That does not look like an email address.</string>
    <string name="login_password_required">Enter your password.</string>

    <!--
      These two must stay clearly different. Wrong credentials and no
      connection call for different actions, and the network message says
      outright that the details were not the problem — otherwise someone
      retypes a correct password over and over on a bad signal.

      Neither says which of email or password was wrong: Supabase does not
      tell us, and guessing would be worse than saying nothing.
    -->
    <string name="login_error_credentials">Wrong email or password. Please check and try again.</string>
    <string name="login_error_network">No connection. Your details were not the problem — check your signal or Wi-Fi and try again.</string>
    <string name="login_error_unexpected">Sign-in could not be completed (%1$s). Please try again in a moment.</string>
    <string name="login_error_no_detail">no details</string>

    <!-- ── Role gate (M6.9) ──────────────────────────────────────────
      Shown to an account that signed in successfully but may not
      administer the catalogue. The requirement is an explanation rather
      than a blank screen, so each message says what happened, whose
      problem it is, and what to do next.

      The refused and unavailable cases are worded apart on purpose. One
      is a decision about the account; the other is the app admitting it
      could not find out. Merging them would tell the shop owner they are
      not an administrator of their own catalogue whenever the signal
      drops — the same misdiagnosis M6.7's error split exists to prevent.
    -->
    <string name="access_refused_title">You cannot manage the catalogue</string>
    <string name="access_refused_not_admin">You are signed in, but this account is not an administrator. Ask the shop owner to give it access, then tap Try again.</string>
    <string name="access_refused_no_profile">You are signed in, but this account has not been set up to manage the catalogue. Ask the shop owner to set it up, then tap Try again.</string>

    <string name="access_unavailable_title">Could not check your access</string>
    <!-- Says outright that the account is not at fault, for the same
         reason login_error_network does. -->
    <string name="access_unavailable_offline">No connection, so your access could not be checked. Nothing is wrong with your account — check your signal or Wi-Fi and tap Try again.</string>
    <string name="access_unavailable_detail">Your access could not be checked (%1$s). Please tap Try again in a moment.</string>
    <string name="access_unavailable_no_detail">no details</string>

    <string name="access_retry">Try again</string>
    <string name="access_sign_out">Sign out</string>
</resources>
