<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The launcher label. Short deliberately: Android truncates a long
      label under the icon, and "SN Jewellery & Silver Palace" would be
      unreadable there. brand.md §1 allows the short form where space
      genuinely constrains it, which is the same reason the website's
      mobile header uses site.shortName.
    -->
    <string name="app_name">SN Admin</string>

    <!-- ── Dashboard (M6.11) ─────────────────────────────────────────
      The four figures the PRD's Dashboard section names. Its wording is
      kept exactly — "Total Products", "New Uploads", "Featured
      Products", "Recently Added" — per CLAUDE.md §5: the PRD's domain
      terms are the app's terms, and a synonym here would be a second
      name for the same thing.

      The PRD defines no window for "New Uploads", so the screen states
      the one chosen rather than leaving the owner to guess whether the
      number covers a day, a week or all time.
    -->
    <string name="dashboard_total_products">Total Products</string>
    <string name="dashboard_new_uploads">New Uploads</string>
    <string name="dashboard_new_uploads_window">last 7 days</string>
    <string name="dashboard_featured">Featured Products</string>
    <string name="dashboard_recently_added">Recently Added</string>

    <!-- ux.md rule 3: "nothing here" is not "something broke". No
         products yet is a normal state for a shop that has just
         installed the app, so it is a statement, not an error. -->
    <string name="dashboard_empty">No products yet.</string>

    <!-- Offline and server-fault worded apart, as on the login and role
         screens: only the first is something the owner can act on. -->
    <string name="dashboard_error_offline">No connection, so the figures could not be loaded. Check your signal or Wi-Fi and try again.</string>
    <string name="dashboard_error_server">The figures could not be loaded (%1$s). Please try again in a moment.</string>
    <string name="dashboard_error_no_detail">no details</string>
    <string name="dashboard_retry">Try again</string>

    <!-- Whether this build was given backend credentials. An admin
         handed a build without them would otherwise meet a network
         error and go looking for a signal problem that does not exist. -->
    <!-- Only the failure is stated now. A green "Backend configured"
         earned its place when the screen had nothing else on it; beside
         real figures it is noise, and the figures loading is the same
         proof. -->
    <string name="dashboard_backend_missing">Not configured — missing %1$s in local.properties</string>

    <!-- On the dashboard's top bar. Worded the same as the refusal
         screen's escape hatch, because they do the same thing. -->
    <string name="dashboard_sign_out">Sign out</string>
    <string name="dashboard_add_product">Add product</string>

    <!-- ── Add Product (M7.1) ────────────────────────────────────────
      The PRD's Add Product section names eight fields and this uses its
      words for all of them, per CLAUDE.md §5.

      Note what is NOT here: Summary. The PRD does not list it, but the
      website's product card renders that column as its short
      description — so a piece uploaded from the app shows no short
      description where the seeded ones do. Flagged in
      DEVELOPMENT_PLAN.md rather than fixed by inventing a ninth field
      on a form used between customers.
    -->
    <string name="add_product_title">Add Product</string>
    <string name="add_product_back">Back</string>
    <string name="add_product_name">Product Name</string>
    <string name="add_product_category">Category</string>
    <!-- A hidden category is offered, not withheld: filing a piece into
         one before a launch is what hidden categories are for. -->
    <string name="add_product_category_hidden">%1$s (hidden)</string>
    <string name="add_product_purity">Purity</string>
    <string name="add_product_purity_none">Not recorded</string>
    <string name="add_product_weight">Weight (grams)</string>
    <string name="add_product_description">Description</string>
    <string name="add_product_tags">Tags</string>
    <string name="add_product_tags_hint">Separate with commas</string>
    <string name="add_product_featured">Featured</string>
    <string name="add_product_save">Save</string>

    <string name="add_product_options_loading">Loading categories…</string>
    <string name="add_product_options_offline">No connection, so categories could not be loaded.</string>
    <string name="add_product_options_error">Categories could not be loaded (%1$s).</string>
    <string name="add_product_options_retry">Try again</string>

    <!-- Offline says outright that nothing was saved: the owner has just
         typed a piece in and needs to know it is still theirs to retry. -->
    <string name="add_product_error_offline">No connection, so the piece was not saved. Nothing you entered has been lost — check your signal and tap Save again.</string>
    <string name="add_product_error_server">The piece could not be saved (%1$s). Nothing you entered has been lost — please try again.</string>
    <string name="add_product_error_no_detail">no details</string>
    <!-- The one failure retrying cannot fix, so it asks for the one
         thing that can: a different name. -->
    <string name="add_product_error_name_taken">There are already too many pieces with this name. Please give this one a slightly different name.</string>

    <!-- ── Field validation (M7.2) ───────────────────────────────────
      Each mirrors a constraint the database enforces anyway, said in
      words the owner can act on and before a round trip — never instead
      of the database. No message blames the person (ux.md rule 5).

      The weight messages exist because M7.1 SILENTLY DISCARDED anything
      unparseable: a mistyped weight saved as "not weighed" without a
      word. Found by driving the form, not by reading the code.
    -->
    <string name="add_product_error_name_blank">Give the piece a name.</string>
    <string name="add_product_error_category_missing">Choose a category.</string>
    <string name="add_product_error_weight_nan">Weight should be a number, like 12.5. Leave it empty if the piece has not been weighed.</string>
    <string name="add_product_error_weight_positive">Weight should be more than zero. Leave it empty if the piece has not been weighed.</string>

    <!-- ── Photographs (M7.3) ────────────────────────────────────────
      The PRD calls this section "Upload Images". "Photographs" is used
      on screen because that is what the owner is looking at — pictures
      of a piece, not files being uploaded, which is a thing the app does
      later and by itself. The domain-term rule in CLAUDE.md §5 governs
      code and schema; this is a label.
    -->
    <string name="add_product_images">Photographs</string>
    <!-- Says what the order will mean before there is an order to see,
         because the first photograph becoming the main image is not
         something anyone would guess. -->
    <string name="add_product_images_empty">No photographs yet. The first one you add becomes the main image.</string>
    <string name="add_product_take_photo">Take photo</string>
    <!-- M7.4. "Choose photos", not "Gallery": the owner is choosing
         pictures of a piece, not browsing an app by its name. -->
    <string name="add_product_choose_photos">Choose photos</string>
    <string name="add_product_images_adding">Adding photographs…</string>
    <!-- Announced by the screen reader. The photograph itself has no
         description anyone could write, so the position is what is read
         out — and the position is the thing M7.5 lets the owner change. -->
    <string name="add_product_image_position">Photograph %1$d of %2$d</string>

    <!-- ── Ordering and removal (M7.5) ────────────────────────────────
      The first photograph is labelled rather than numbered, because
      being first is the only thing about it the owner needs to act on:
      it is what the website shows on the product card and at the top of
      the gallery.
    -->
    <string name="add_product_image_main">Main image</string>
    <string name="add_product_image_number">Photograph %1$d</string>
    <!-- Read out by the screen reader, so each says which photograph it
         acts on — three identical "Move up" buttons in a list would be
         unusable without it. -->
    <string name="add_product_image_move_earlier">Move photograph %1$d earlier</string>
    <string name="add_product_image_move_later">Move photograph %1$d later</string>
    <string name="add_product_image_remove">Remove photograph %1$d</string>

    <!--
      The camera failures, worded apart because each calls for a
      different action. Refusing this time and refusing for good look
      identical to the app unless it asks the system which it was, and
      telling someone to tap again when the system has stopped asking is
      a button that does nothing.

      None of them blames the person (ux.md rule 5). Both camera messages
      now name the alternative, because since M7.4 there is one: choosing
      an existing photograph needs no permission at all.
    -->
    <string name="add_product_camera_refused">Photographs need the camera. Tap Take photo to be asked again, or choose one you have already taken.</string>
    <string name="add_product_camera_blocked">Camera access is turned off for this app, so photographs cannot be taken here. Turn it on in Settings, or choose photos you have already taken.</string>
    <string name="add_product_camera_settings">Open Settings</string>
    <string name="add_product_camera_none">This phone has no camera app that can take a photograph. You can still choose photos you have already taken.</string>
    <string name="add_product_gallery_none">This phone has no way to choose an existing photo.</string>
    <string name="add_product_photo_no_storage">There is no room left on the phone for a photograph. Free up some space and try again.</string>

    <!-- Says how many, because the ones that worked are already on
         screen and a bare "something failed" leaves the owner counting
         thumbnails to work out what they still have to do. -->
    <plurals name="add_product_photos_not_added">
        <item quantity="one">One photo could not be added. Try choosing it again.</item>
        <item quantity="other">%1$d photos could not be added. Try choosing them again.</item>
    </plurals>

    <!-- ── Login (M6.7) ──────────────────────────────────────────── -->
    <string name="login_subtitle">Sign in to manage the catalogue.</string>
    <string name="login_email_label">Email</string>
    <string name="login_password_label">Password</string>
    <string name="login_password_show">Show</string>
    <string name="login_password_hide">Hide</string>
    <string name="login_submit">Sign in</string>

    <string name="login_email_required">Enter your email address.</string>
    <string name="login_email_malformed">That does not look like an email address.</string>
    <string name="login_password_required">Enter your password.</string>

    <!--
      These two must stay clearly different. Wrong credentials and no
      connection call for different actions, and the network message says
      outright that the details were not the problem — otherwise someone
      retypes a correct password over and over on a bad signal.

      Neither says which of email or password was wrong: Supabase does not
      tell us, and guessing would be worse than saying nothing.
    -->
    <string name="login_error_credentials">Wrong email or password. Please check and try again.</string>
    <string name="login_error_network">No connection. Your details were not the problem — check your signal or Wi-Fi and try again.</string>
    <string name="login_error_unexpected">Sign-in could not be completed (%1$s). Please try again in a moment.</string>
    <string name="login_error_no_detail">no details</string>

    <!-- ── Role gate (M6.9) ──────────────────────────────────────────
      Shown to an account that signed in successfully but may not
      administer the catalogue. The requirement is an explanation rather
      than a blank screen, so each message says what happened, whose
      problem it is, and what to do next.

      The refused and unavailable cases are worded apart on purpose. One
      is a decision about the account; the other is the app admitting it
      could not find out. Merging them would tell the shop owner they are
      not an administrator of their own catalogue whenever the signal
      drops — the same misdiagnosis M6.7's error split exists to prevent.
    -->
    <string name="access_refused_title">You cannot manage the catalogue</string>
    <string name="access_refused_not_admin">You are signed in, but this account is not an administrator. Ask the shop owner to give it access, then tap Try again.</string>
    <string name="access_refused_no_profile">You are signed in, but this account has not been set up to manage the catalogue. Ask the shop owner to set it up, then tap Try again.</string>

    <string name="access_unavailable_title">Could not check your access</string>
    <!-- Says outright that the account is not at fault, for the same
         reason login_error_network does. -->
    <string name="access_unavailable_offline">No connection, so your access could not be checked. Nothing is wrong with your account — check your signal or Wi-Fi and tap Try again.</string>
    <string name="access_unavailable_detail">Your access could not be checked (%1$s). Please tap Try again in a moment.</string>
    <string name="access_unavailable_no_detail">no details</string>

    <string name="access_retry">Try again</string>
    <string name="access_sign_out">Sign out</string>
</resources>
