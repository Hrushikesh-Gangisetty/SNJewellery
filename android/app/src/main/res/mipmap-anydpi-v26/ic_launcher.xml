<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon. minSdk is 26, so this is the only launcher icon the app
  needs — no legacy density-bucket PNGs, which is one of the practical
  benefits of the minSdk decision in docs/architecture/android-build.md.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
