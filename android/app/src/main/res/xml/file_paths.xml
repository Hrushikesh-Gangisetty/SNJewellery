<?xml version="1.0" encoding="utf-8"?>
<!--
  What the FileProvider in AndroidManifest.xml is allowed to share.

  Two directories, and deliberately the narrowest ones: a camera app gets
  a URI for a single file under `cache/staged/` and nothing else. Naming
  either root instead would expose the session-derived material Coil and
  OkHttp keep alongside them.

  Why staging uses the cache is in CacheStagedImages. `drafts/` is under
  `files/` for the opposite reason: an offline draft (M8.9) may wait days
  for a signal, and the cache is exactly what Android empties when
  storage runs short.
-->
<paths>
    <cache-path
        name="staged"
        path="staged/" />
    <files-path
        name="drafts"
        path="drafts/" />
</paths>
