<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves the device. The app holds an authenticated admin
  session (M6.8), and a session token in a cloud backup or copied to a
  new phone by device transfer is a credential outside the device's
  protected storage. See CLAUDE.md §9.

  This is the Android 12+ replacement for android:allowBackup, which
  stays set for older versions.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
