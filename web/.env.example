# ─────────────────────────────────────────────────────────────
# Website environment — copy to `.env.local` and fill in.
#
#   cp web/.env.example web/.env.local
#
# `.env.local` is gitignored. Never commit real values.
# These are validated at startup by lib/config — a missing or
# malformed variable fails the build rather than surfacing as a
# runtime error later. See CLAUDE.md §9.
# ─────────────────────────────────────────────────────────────


# ── Supabase ─────────────────────────────────────────────────
# From your Supabase project: Settings → API.
# Set in M3.1.

# Project URL. Example: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The ANON (public) key — safe to expose to the browser, because
# row-level security is what restricts it to reading published
# products. See docs/adr/0004-authentication-and-roles.md
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠ The SERVICE ROLE key is deliberately absent and must NEVER
#   appear in this file or anywhere in web/. It bypasses RLS.
#   M5.3 verifies it is not present in the built output.


# ── Site ─────────────────────────────────────────────────────

# Canonical origin, no trailing slash. Used for canonical URLs,
# Open Graph tags, and sitemap.xml (M11).
#   local:      http://localhost:3000
#   production: https://your-domain.example
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ── Revalidation ─────────────────────────────────────────────
# Server-side only (no NEXT_PUBLIC_ prefix). Shared secret the
# Supabase webhook presents when telling the site a product
# changed. Requests without it are rejected.
# Set in M9.2. Generate with: openssl rand -hex 32
REVALIDATION_SECRET=


# ── Maps ─────────────────────────────────────────────────────
# Only needed if the Contact page uses the Google Maps
# JavaScript/Embed API rather than a plain iframe embed.
# A plain iframe needs no key — prefer that if it suffices (M4.10).
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=


# ── Deployment environment (set by the platform) ──────────────
# VERCEL_ENV is injected by Vercel as production | preview |
# development. DO NOT set it here or in Vercel's own environment
# variables — overriding it is how a preview ends up telling
# search engines to index it.
#
# It decides one thing: whether this deployment may appear in
# search results. Absent — a local `next dev`, CI, a container —
# is read as "development", which is the cautious direction: not
# indexed. See web/lib/config/env.ts and M5.5.
