{
  "name": "snjewellery",
  "private": true,
  "description": "Repository-level tooling. The website lives in web/, the admin app in android/.",
  "scripts": {
    "tokens": "node tools/generate-tokens.mjs",
    "tokens:check": "node tools/generate-tokens.mjs --check",
    "db:link": "supabase link",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff",
    "db:reset": "supabase db reset",
    "db:seed": "supabase db reset",
    "db:types": "supabase gen types typescript --linked > web/lib/data/database.types.ts",
    "db:test-rls": "node supabase/tests/rls.mjs --from-cli"
  },
  "devDependencies": {
    "supabase": "2.109.1"
  }
}
